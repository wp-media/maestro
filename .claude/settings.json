{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/maestro.json\" ] && echo '=== Maestro project config ===' && cat \"${CLAUDE_PROJECT_DIR}/.claude/maestro.json\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/plugins/marketplaces/maestro/bin/auto-update.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

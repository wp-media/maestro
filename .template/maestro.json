{
  "_note": "Copy to .claude/maestro.json and fill in all fields. Remove the editions block entirely if the plugin has no free/pro split. Remove null tooling entries that don't apply.",

  "_stack_note": "Resolved stack block — written by /onboard-project after derive-then-confirm. Agents read ONLY this flat block; commands are flattened to strings. ai.e2e is now an alias of stack.harness during migration (stack.harness is the source of truth, ai.e2e mirrors it).",
  "stack": {
    "profile": "wordpress",
    "profile_version": "1",
    "verification": {
      "lint": "composer phpcs-changed", "lint_fallback": "composer run phpcs",
      "autofix": "composer phpcs:fix",
      "typecheck": "composer run-stan", "typecheck_fallback": "composer phpstan",
      "test_unit": "composer test-unit", "test_unit_fallback": "composer test",
      "build": null
    },
    "source_dirs": ["src/", "inc/", "classes/"],
    "public_api_surface": ["WordPress hooks", "AJAX actions, REST routes", "option_keys, capabilities", "WP-CLI commands"],
    "harness": {
      "kind": "wp-local", "base_url": "http://localhost:8888",
      "boot_cmd": "bash .maestro/bin/dev-up.sh", "ui_entry": "/wp-admin/options-general.php?page=wprocket",
      "browser_login": { "url": "/wp-login.php", "user": "admin", "pass": "password" },
      "e2e_runner": "npx --yes playwright test"
    },
    "gates": ["compliance"],
    "variants": { "concept": "editions", "values": ["free", "pro"] }
  },

  "name": "<project-slug>",
  "repo": "wp-media/<project-slug>",
  "type": "wordpress-plugin",
  "description": "<Plugin description>",
  "entrypoints": {
    "plugin_bootstrap": "<main-file>.php",
    "uninstall": "uninstall.php"
  },

  "_editions_note": "Only present for plugins with a free/pro split. Remove entirely for single-edition plugins.",
  "editions": {
    "free": {
      "paths": [
        "<main-file>.php",
        "inc/",
        "src/",
        "views/",
        "components/",
        "parts/",
        "pages/"
      ],
      "notes": [
        "Shared core and FREE features live here.",
        "FREE must not reference PRO namespaces or classes."
      ]
    },
    "pro": {
      "paths": [
        "inc/Pro/",
        "pro/"
      ],
      "notes": [
        "PRO features extend FREE via composition.",
        "No feature flags inside shared services."
      ]
    }
  },

  "areas": [
    {
      "path": "src/",
      "role": "namespaced-php",
      "notes": "Modern PSR-4 codebase."
    },
    {
      "path": "inc/",
      "role": "legacy-php",
      "notes": "Non-namespaced classes and admin pages."
    },
    {
      "path": "inc/Pro/",
      "role": "legacy-php-pro",
      "notes": "PRO-only legacy classes."
    },
    {
      "path": "classes/",
      "role": "legacy-php",
      "notes": "Legacy class files."
    },
    {
      "path": "views/",
      "role": "templates",
      "notes": "PHP templates for admin and frontend."
    },
    {
      "path": "components/",
      "role": "template-components",
      "notes": "Reusable PHP view/UI components."
    },
    {
      "path": "parts/",
      "role": "template-parts",
      "notes": "Template partials."
    },
    {
      "path": "pages/",
      "role": "template-pages",
      "notes": "Page templates."
    },
    {
      "path": "pro/",
      "role": "pro-only",
      "notes": "PRO-only features and templates."
    },
    {
      "path": "assets/",
      "role": "compiled-assets",
      "notes": "Compiled CSS/JS. Do not edit directly."
    },
    {
      "path": "dist/",
      "role": "compiled-assets",
      "notes": "Compiled output. Do not edit directly."
    },
    {
      "path": "resources/",
      "role": "source-assets",
      "notes": "Source SCSS/JS for compilation."
    },
    {
      "path": "_dev/",
      "role": "source-assets",
      "notes": "Source assets for compilation."
    },
    {
      "path": "languages/",
      "role": "i18n",
      "notes": "Translation files (.pot, .po, .mo)."
    },
    {
      "path": "packages/",
      "role": "local-packages",
      "notes": "Local Composer packages."
    },
    {
      "path": "bin/",
      "role": "tooling",
      "notes": "Shell scripts and CLI helpers."
    },
    {
      "path": "tasks/",
      "role": "tooling",
      "notes": "Build and project task scripts."
    },
    {
      "path": "config/",
      "role": "config",
      "notes": "Build and tooling configuration."
    },
    {
      "path": "tests/",
      "role": "tests",
      "notes": "PHPUnit unit and integration tests."
    },
    {
      "path": "vendor/",
      "role": "third-party",
      "notes": "Composer dependencies. Do not edit."
    },
    {
      "path": "node_modules/",
      "role": "third-party",
      "notes": "NPM dependencies. Do not edit."
    }
  ],

  "tooling": {
    "composer": "composer.json",
    "phpcs": "phpcs.xml",
    "phpstan": "phpstan.neon.dist",
    "node": "package.json",
    "gulp": "gulpfile.ts",
    "tailwind": "tailwind.config.js",
    "webpack": "webpack.config.js",
    "vite": "vite.config.js",
    "jest": "jest.config.js",
    "playwright": "playwright.config.ts"
  },

  "notes": [
    "Prefer minimal diffs and avoid unrelated formatting changes.",
    "Do not edit generated output in dist/ or assets/ unless explicitly requested."
  ],

  "ai": {
    "_note": "Read by Maestro agents at session start.",

    "slug": "<project-slug>",
    "display_name": "<Human Readable Plugin Name>",
    "repo": "wp-media/<project-slug>",
    "temp_root": ".maestro",

    "architecture_skill": "<project-slug>-architecture",
    "frontend_skill": "<project-slug>-frontend-architecture",

    "text_domain": "<text-domain>",
    "_namespace_note": "Root PHP namespace for the plugin (e.g. WP_Rocket, WPMedia\\BackWPup). Used for documentation and architecture skills; not yet read programmatically.",
    "namespace": "<PHP\\Namespace\\Root>",

    "rest_namespace": null,

    "_push_agent_note": "Reserved for future use — identifies the agent responsible for pushing and creating PRs. Not yet read by any command.",
    "push_agent": "release-agent",

    "_editions_note": "Signal only. Set to [\"free\",\"pro\"] when the plugin has editions. The detailed path mapping lives in the root-level editions block above.",
    "editions": null,

    "capabilities": [],

    "slack_channel": null,
    "slack_threads_dir": null,

    "_html_log_note": "Set to true to enable the token-heavy HTML workflow log (legacy). Default false — Podium captures all pipeline events via zero-token Claude Code hooks.",
    "html_log": false,

    "e2e": {
      "_note": "boot_cmd is set by onboard-project to the resolved Maestro bin path. seed_cmd points to the project-specific seed script in .maestro/bin/.",
      "local_url": "http://localhost:8888",
      "boot_cmd": null,
      "seed_cmd": "bash .maestro/bin/dev-seed.sh",
      "test_cmd": null,
      "settings_path": "/wp-admin/options-general.php?page=<plugin-page>",
      "ci_integration": false,
      "_license_option_key_note": "WP option key that holds the plugin license/activation data. Used by e2e-qa-tester to skip licensed-feature tests when the license is not active. Set to null if the plugin has no license gating.",
      "license_option_key": null
    }
  }
}
